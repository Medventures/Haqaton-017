[Unit]
Description=medhub background processing
After=network-online.target medhub-api.service
Wants=network-online.target

[Service]
Type=simple
User=medhub
Group=medhub
WorkingDirectory=/opt/medhub/current/backend
EnvironmentFile=/opt/medhub/shared/app.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/medhub/current/.venv/bin/python -m app.worker
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/medhub/shared/audio
MemoryMax=768M

[Install]
WantedBy=multi-user.target
