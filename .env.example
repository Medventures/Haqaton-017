POSTGRES_DB=medhub
POSTGRES_USER=medhub
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgresql+psycopg://medhub:replace-with-random-password@db:5432/medhub
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0
# Генерируются scripts/setup.ps1; сохраняйте резервную копию ключей отдельно от БД.
ENCRYPTION_KEY=
INDEX_KEY=
PUBLIC_ORIGIN=http://localhost:5173
SECURE_COOKIES=false
DEMO_MODE=false
DEMO_PASSWORD=
REGISTRATION_CODE=
AUDIO_DIR=/data/audio
# Записи приёмов сохраняются постоянно в зашифрованном виде.
AUDIO_RETENTION_HOURS=0
MAX_AUDIO_MB=80
SIGEX_ENABLED=true
SIGEX_URL=https://sigex.kz
# Java 17+ для локальной проверки ЭЦП (библиотеки: backend/verifier/README.md).
EDS_JAVA_COMMAND=java
# true: запись и обработка разрешены только после проверенной ЭЦП пациента.
CONSENT_SIGNATURE_REQUIRED=true
# openai | faster_whisper | self_hosted | disabled
# OpenAI получает исходное аудио только с отдельным согласием пациента.
ASR_PROVIDER=openai
# Только серверный ключ проекта OpenAI API; не передавать в Vue/VITE_*.
# Модель: gpt-4o-transcribe-diarize (текст + таймкоды + говорящие).
OPENAI_API_KEY=
ASR_MODEL=/models/faster-whisper-large-v3
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# На GPU-ПК с 12 GB: DIARIZATION_BATCH_SIZE=4, ASR_RELEASE_CUDA_CACHE=true.
DIARIZATION_BATCH_SIZE=32
ASR_RELEASE_CUDA_CACHE=false
DIARIZATION_MODEL=/models/pyannote-speaker-diarization-community-1
ASR_URL=http://host.docker.internal:8090
ASR_API_KEY=
# Необязательный второй проход: только после локального ASR, заглушения и проверки врачом.
CLOUD_ASR_URL=
CLOUD_ASR_API_KEY=
CLOUD_ASR_MODEL=whisper-1
# Сборка тяжёлого ASR image только по запросу.
INSTALL_LOCAL_AI=false
MODELS_PATH=./models
# openai | ollama | openai_compatible | disabled
LLM_PROVIDER=openai
LLM_URL=http://host.docker.internal:11434
# Облегчённая LLM; Responses API, reasoning.effort=low.
LLM_MODEL=gpt-5.6-terra
# Для LM Studio задайте json_schema; остальные провайдеры сохраняют json_object.
LLM_RESPONSE_FORMAT=json_object
# Параметры только openai_compatible. Пустой effort и max_tokens=0 не передаются.
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=0
# Экспериментальный профиль Qwen: none, 2048, temperature=0.1; качество см. deploy/gpu/windows/WINDOWS.md.
# LLM_TEMPERATURE=0.1
LLM_API_KEY=
LLM_IS_CLOUD=true
# Пример OpenAI: LLM_PROVIDER=openai_compatible, LLM_URL=https://api.openai.com/v1,
# LLM_IS_CLOUD=true, LLM_MODEL=<модель с поддержкой JSON>, LLM_API_KEY=<секрет>.
MIS_URL=
MIS_TOKEN=
